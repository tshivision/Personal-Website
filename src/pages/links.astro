---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import ResourceGrid from '../components/ResourceGrid.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { featured } from '../lib/resources';
import { SITE } from '../site.config';
---
<Base title="Links" description={SITE.linksDescription} backLink={false}>
  <div class="wrap links">
    <div class="fade-up"><Hero /></div>
    {featured && <div class="fade-up" style="--base:120ms"><FeaturedCard resource={featured} /></div>}
    <div class="fade-up" style="--base:240ms"><ResourceGrid /></div>
    <div data-reveal><EmailSignup /></div>
    <a class="work-link" href="/" data-reveal>
      <span>I’m also a product designer</span>
      <strong>See my design work <span aria-hidden="true">→</span></strong>
    </a>
  </div>
</Base>

<style>
  .links { padding-top: 0.5rem; }
  .work-link {
    display: flex; flex-direction: column; gap: 0.2rem;
    margin-top: 2.5rem; padding: 1.25rem 1.4rem;
    border-radius: var(--radius); background: var(--ink); color: #fff; text-decoration: none;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  .work-link span { font-size: 0.875rem; color: #c9c9c9; }
  .work-link strong { font-size: 1.125rem; }
  .work-link:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
</style>
