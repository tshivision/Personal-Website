---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap page">
    <h1>This page wandered off</h1>
    <p>It may have moved, or the link had a typo.</p>
    <a class="btn" href="/">Back to home</a> <a class="btn btn--ghost" href="/links">Free resources</a>
  </div>
</Base>
<style>
  .page { padding-top: 3rem; }
  h1 { font-size: 2.25rem; }
  p { color: var(--ink-2); margin: 0.75rem 0 1.5rem; }
</style>
