---
import { hrefFor, type Resource } from '../lib/resources';
interface Props { resource: Resource }
const { resource: r } = Astro.props;
const href = hrefFor(r)!;
const external = r.type === 'external';
---
<section class="featured" aria-labelledby="featured-title">
  <img src={r.thumbnail} alt="" width="96" height="96" class="thumb" />
  <p class="eyebrow">From my latest reel</p>
  <h2 id="featured-title">{r.title}</h2>
  <p class="sub">{r.subtitle}</p>
  <a class="btn btn--block" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
    Get it free <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .featured {
    margin-top: 1.5rem;
    padding: 1.25rem 1.25rem 1.4rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .thumb {
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }
  h2 { font-size: 1.75rem; margin-top: 0.35rem; }
  .sub { color: var(--ink-2); margin: 0.4rem 0 1.25rem; }
</style>
