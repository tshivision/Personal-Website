---
import EmailSignup from './EmailSignup.astro';
interface Props {
  id: string;
  title: string;
  lede: string;
  bullets: string[];
}
const { id, title, lede, bullets } = Astro.props;
---
<article class="wrap page">
  <p class="eyebrow">Coming soon</p>
  <h1>{title}</h1>
  <p class="lede">{lede}</p>
  <div class="prose body">
    <slot />
    <h2>What you'll get</h2>
    <ul>{bullets.map((b) => <li>{b}</li>)}</ul>
  </div>
  <EmailSignup
    id={`${id}-signup`}
    heading="Get it the day it launches"
    text="Leave your email and I'll send it to you first, free."
    button="Notify me"
    interest={id}
  />
</article>

<style>
  .page { padding-top: 1.5rem; }
  h1 { font-size: clamp(2.25rem, 10vw, 3rem); margin-top: 0.5rem; }
  .lede { font: italic 400 1.25rem/1.45 var(--serif); color: var(--ink-2); margin-top: 0.75rem; }
  .body { margin-top: 1.75rem; }
  .body :global(h2) { font-size: 1.25rem; margin-top: 1.75rem; }
</style>
