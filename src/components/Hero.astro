---
import { SITE } from '../site.config';
---
<header class="hero">
  {SITE.photo
    ? <img class="avatar" src={SITE.photo} alt={`Portrait of ${SITE.name}`} width="80" height="80" />
    : <div class="avatar avatar--mono" aria-hidden="true">TS</div>}
  <h1>{SITE.name}</h1>
  <p class="tagline">{SITE.tagline}</p>
  <p class="proof">{SITE.proof}</p>
  <p class="intro">{SITE.intro}</p>
</header>

<style>
  .hero { padding-top: 2rem; }
  .avatar {
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
  }
  .avatar--mono {
    display: grid;
    place-items: center;
    background: var(--line);
    color: var(--ink-2);
    font: 600 1.5rem/1 var(--serif);
  }
  h1 { font-size: clamp(2.5rem, 11vw, 3.25rem); letter-spacing: -0.02em; }
  .tagline {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ink-2);
    margin-top: 0.35rem;
  }
  .proof {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-3);
  }
  .intro { margin-top: 1rem; max-width: 30rem; }
</style>
