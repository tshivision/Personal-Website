---
import { SITE } from '../site.config';
import Footer from './Footer.astro';
const words = "Let's build something good.".split(' ');
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap-wide">
    <p class="eyebrow" data-reveal>Get in touch</p>
    <h2 id="contact-title" class="title" data-reveal>
      {words.map((w, i) => <span class="cw" style={`--i:${i}`}>{w}</span>)}
    </h2>
    <div class="row" data-reveal style="--d:150ms">
      <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <button type="button" class="copy" data-copy={SITE.email} aria-label="Copy email address">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8"/></svg>
        <span data-copy-label aria-live="polite">Copy</span>
      </button>
    </div>
    <ul class="actions" data-reveal style="--d:250ms">
      <li><a class="btn" href={`mailto:${SITE.email}`}>Email me <span class="arrow" aria-hidden="true">→</span></a></li>
      {SITE.linkedin && <li><a class="btn btn--ghost" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>}
      <li><a class="btn btn--ghost" href={SITE.resume} target="_blank" rel="noopener">Resume <span aria-hidden="true">↗</span></a></li>
    </ul>
  </div>
</section>
<Footer />

<style>
  .contact {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }
  .title { font-size: clamp(2.5rem, 8vw, 6rem); letter-spacing: -0.045em; margin-top: 1rem; max-width: 14ch; }
  .cw { display: inline-block; margin-right: 0.22em; transition: color 0.4s; }
  .title:hover .cw { color: var(--ink-3); }
  .title .cw:hover { color: var(--accent); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 2rem; }
  .email {
    font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 500; color: var(--accent);
    text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 0.2em;
    text-decoration-color: rgb(41 68 164 / 0.35);
    transition: text-decoration-color 0.2s;
  }
  .email:hover { text-decoration-color: currentColor; }
  .copy {
    display: inline-flex; align-items: center; gap: 0.4rem;
    min-height: 2.5rem; padding: 0 0.9rem; border: 0; border-radius: 999px;
    background: var(--surface); color: var(--ink-2); box-shadow: var(--shadow-sm);
    font: 500 0.875rem/1 var(--sans); cursor: pointer;
    transition: background-color 0.2s, color 0.2s, transform 0.2s var(--ease-out);
  }
  .copy:hover { color: var(--ink); transform: translateY(-1px); }
  .copy.is-copied { background: var(--accent); color: #fff; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; list-style: none; margin: 2.25rem 0 0; padding: 0; }
</style>
