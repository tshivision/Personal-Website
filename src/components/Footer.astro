---
import { SITE } from '../site.config';

const icons: Record<string, string> = {
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>',
  tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.6"/>',
  youtube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/>',
};
const year = new Date().getFullYear();
---
<footer class="wrap footer">
  <ul class="socials" aria-label="Social links">
    {SITE.socials.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener" aria-label={`${s.label} (opens in new tab)`}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
        </a>
      </li>
    ))}
  </ul>
  <p class="small">© {year} {SITE.name} · {SITE.handle}</p>
</footer>

<style>
  .footer {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    text-align: center;
  }
  .socials {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--ink-2);
    transition: color 0.15s, background-color 0.15s;
  }
  .socials a:hover { color: var(--accent); background: var(--accent-tint); }
  .small { font-size: 0.8125rem; color: var(--ink-3); }
</style>
